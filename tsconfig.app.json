{
  "compilerOptions": {
    "target": "ES2022", "useDefineForClassFields": true, "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext", "moduleResolution": "bundler", "jsx": "react-jsx",
    "strict": true, "noEmit": true, "isolatedModules": true, "esModuleInterop": true,
    "skipLibCheck": true, "forceConsistentCasingInFileNames": true, "resolveJsonModule": true,
    "types": ["node", "vite/client"]
  },
  "include": ["src"]
}
